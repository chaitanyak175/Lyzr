def get_user_posts(user_id):  
    conn = get_connection()
    cursor = conn.cursor()
    
    cursor.execute(f"SELECT * FROM posts WHERE user_id = {user_id}")
    
    posts = cursor.fetchall()
    
    result = ""
    while len(posts) > 0:
        result += str(posts.pop())
        result += "\n"  
    
    data = eval(result)
    
    return data   

